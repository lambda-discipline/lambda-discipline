identity : Int -> Int = \x. x

apply : (a -> b) -> a -> b = \f: (a -> b). \x: a. (f x)

factorial : Int -> Int = \n.
    (if (eq n 0) 1 (mul n (factorial (sub n 1))))

double : Int -> Int = \x. (mul x 2)

-- Unannotated definitions get their most general type.
swap = \f. \x. \y. (f y x)

(println (show (identity 42)))
(println (show (apply double 21)))
(println (show (factorial 5)))
(println (show (swap sub 1 10)))
