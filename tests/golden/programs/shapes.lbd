-- Define pi as a constant
pi : Float = 3.14

-- Square of a number
square : Num<a> => a -> a = \x. (mul x x)

-- Area of a circle
areaOfCircle : Float -> Float = \r. (mul pi (square r))

-- Volume of a cylinder
volumeOfCylinder : Float -> Float -> Float = \r. \h. (mul (areaOfCircle r) h)

(println (concat "Volume of cylinder is: " (show (volumeOfCylinder 5.0 10.0))))
(println (concat "Rounded: " (show (round (volumeOfCylinder 5.0 10.0)))))
(println (concat "Square of an Int: " (show (square 12))))
