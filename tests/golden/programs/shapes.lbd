-- Define pi as a constant
pi : Float = 3.14

-- Square of a number
square : Num<a> => a -> a = \x. (mul x x)

-- Area of a circle
areaOfCircle : Float -> Float = \r. (mul pi (square r))

-- Volume of a cylinder
volumeOfCylinder : Float -> Float -> Float = \r. \h. (mul (areaOfCircle r) h)

(println "Volume of cylinder is: " (volumeOfCylinder 5.0 10.0))
(println "Rounded: " (round (volumeOfCylinder 5.0 10.0)))
(println "Square of an Int: " (square 12))
