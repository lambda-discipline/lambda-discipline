-- Shadows the builtin `abs`.
abs : Number -> Number = \x. (if (lt x 0) (neg x) x)

zero : Number = 0.0
negativeNumber : Number = -42.0
largeNumber : Number = 999999.0

(println (abs zero))
(println (abs negativeNumber))
(println (add (mul largeNumber 2) 1))
(println (div 1 3))
(println (div 1 0))
(println 1e21 " " 2.5e-3)
