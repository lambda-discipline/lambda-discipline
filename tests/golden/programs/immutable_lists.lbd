-- Lists are immutable: operations return new lists.
empty : List<String> = []
one : List<String> = (push "Hello" empty)
two : List<String> = (push "World" one)

(println (concat "empty: " (show empty)))
(println (concat "one: " (show one)))
(println (join "" ["two: ", (show two), ", size ", (show (length two))]))
(println (concat "second: " (show (get 1 two))))
(println (concat "without first: " (show (remove 0 two))))
(println (concat "two is unchanged: " (show two)))
