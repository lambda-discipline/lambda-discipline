greeting : String = (concat "Hello, " "World")
(println greeting)
(println (show (stringLength greeting)))
(println (show (split ", " greeting)))
(println (join "-" (chars "abc")))
(println (show (lines "first\nsecond\r\nthird")))
(println (show (add (unwrapOk (parseFloat " 2.5 ")) 1.0)))
(println (show "quoted\tand escaped"))
(println "unicode: \u{3bb}")
