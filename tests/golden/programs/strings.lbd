greeting : String = (concat "Hello, " "World")
(println greeting)
(println (stringLength greeting))
(println (split ", " greeting))
(println (join "-" (chars "abc")))
(println (lines "first\nsecond\r\nthird"))
(println (add (parseNumber " 2.5 ") 1))
(println (show "quoted\tand escaped"))
(println "unicode: \u{3bb}")
