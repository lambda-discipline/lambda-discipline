-- Effects happen only when an action is performed, never as a side effect
-- of evaluation, so the output does not depend on evaluation order.

-- A definition is never performed on its own.
never = (print "never printed")

-- An unused binding is never performed either.
(let unused = (println "never printed either") in (println "only this line"))

-- A list of actions is just a list until `sequence` runs it.
greetings : List<IO<Unit>> = [(println "a"), (println "b")]
(println (length greetings) " actions")
(sequence greetings)

-- Performing one action twice runs it twice.
twice : IO<a> -> IO<a> = \action. (then action action)
(twice (get 1 greetings))

-- `let x <- action in` performs an action and names its result.
countdown : Int -> IO<Int> = \n.
    (if (eq n 0)
        (pure 0)
        let _ <- (print n " ") in
        let rest <- (countdown (sub n 1)) in
        let total = (add n rest) in
        (pure total))

let total <- (countdown 3) in
(println "total " total)

-- `sequence` collects the results of its actions.
let results <- (sequence [(pure 1), (countdown 2)]) in
(println results)

-- The same with the builtins `let x <- action in` stands for.
(bind (pure 2) \x. (then (print x) (println "!")))
