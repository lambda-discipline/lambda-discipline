numbers : List<Int> = [10, 20, 30, 40, 50]

(println (show (length numbers)))
(println (show (length (map \x. (mul x 2) numbers))))
(println (show (foldr \x. \y. (add x y) 0 numbers)))
(println (join "" [(show (head numbers)), " ", (show (tail numbers))]))
(println (show (reverse numbers)))
(println (join "" [(show (sort [3, 1, 2])), " ", (show (sort ["pear", "apple"]))]))
(println (join "" [(show (take 2 numbers)), " ", (show (drop 3 numbers))]))
(println (join "" [(show (append [1] [2, 3])), " ", (show (cons 0 [1])), " ", (show (isEmpty []))]))
