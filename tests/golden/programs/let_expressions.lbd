-- `let` is recursive and generalized.
result : Int =
    let square = \x. (mul x x) in
    let total = (add (square 3.0) (square 4.0)) in
    (floor (sqrt total))

pairs : List<String> =
    let id = \x. x in
    [(id "polymorphic"), (show (id 1))]

collatz : Int -> Int = \start.
    let go = \n. \steps.
        (if (eq n 1) steps
            (go (if (eq (mod n 2) 0) (div n 2) (add (mul 3 n) 1)) (add steps 1)))
    in (go start 0)

(println (show result))
(println (show pairs))
(println (show (collatz 27)))
