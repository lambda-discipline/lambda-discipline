identity: Number -> Number = \x: Number. x

apply: (Number -> Number) -> Number -> Number = \f: (Number -> Number). \x: Number. (f x)

factorial: Number -> Number = \n: Number.
    (null (cmp 0 n) 1 (mul n (factorial (sub n 1.0))))

double: Number -> Number = \x: Number. (mul x 2.0)

(print (identity 42) "\n")
(print (apply double 21) "\n")
(print (factorial 5) "\n")
