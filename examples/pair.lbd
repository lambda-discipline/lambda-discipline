use "std.lbd"

p : (Int, String) = (1, "one")

(println (show p))
(println (join "" [(show (fst p)), " is ", (snd p)]))
(println (show (swap p)))
(println (show ((uncurry add) (2, 3))))
-- A lambda can take a pair apart in its parameter.
(println (show (map \(n, name). (concat name (show n)) [p, (2, "two")])))
