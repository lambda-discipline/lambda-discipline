a: List = (list)
(print "list: " a "\n")

(listAppend a "Hello")
(print "list: " a "\n")

(print "list size: " (listSize a) "\n")

(listAppend a "World")
(print "list: " a "\n")
(print "list[1]: " (listGet a 1) "\n")

(listAppend a "Foo")
(print "list: " a "\n")
(listRemove a 2)
(print "list: " a "\n")