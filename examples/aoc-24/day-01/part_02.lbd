-- Problem: https://adventofcode.com/2024/day/1 (part two)
-- Run from the crate root: lbd run examples/aoc-24/day-01/part_02.lbd

use "../../std.lbd"

parseLine : String -> List<Number> = \line. (map parseNumber (split "   " line))

-- The puzzle is a pure function of the input text.
similarity : String -> Number = \input.
    let columns = (transpose (map parseLine (lines input))) in
    let left = (get 0 columns) in
    let right = (get 1 columns) in
    (sum (map \x. (mul x (count (eq x) right)) left))

-- Reading the input is an action; `<-` names its result.
let input <- (readFile "examples/aoc-24/day-01/input.txt") in
(println "Answer: " (similarity input))
