-- Problem: https://adventofcode.com/2024/day/1 (part one)
-- Run from the crate root: lbd run examples/aoc-24/day-01/part_01.lbd

parseLine : String -> List<Number> = \line. (map parseNumber (split "   " line))

-- The puzzle is a pure function of the input text.
distance : String -> Number = \input.
    let columns = (transpose (map parseLine (lines input))) in
    let left = (sort (get 0 columns)) in
    let right = (sort (get 1 columns)) in
    (sum (zipWith \a. \b. (abs (sub a b)) left right))

-- Reading the input is an action; `<-` names its result.
let input <- (readFile "examples/aoc-24/day-01/input.txt") in
(println "Answer: " (distance input))
