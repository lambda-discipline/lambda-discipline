-- Booleans
true: Bool = \x: Any. \y: Any. x
false: Bool = \x: Any. \y: Any. y

if: Any = \condition: Any.
    \thenClause: Any. \elseClause: Any.
        (condition thenClause elseClause)

boolToString: Bool = \bool: Bool. (if bool "true" "false")

-- Pairs
pair: Any = \x: Any. \y: Any. \function: Any. (function x y)
-- Apparently, same signature as booleans
first: Any = \x: Any. \y: Any. x
second: Any = \x: Any. \y: Any. y

-- Relational Operators
eq: Float -> Float -> Bool = \x: Float. \y: Float.
    (null (cmp x y) true false)

lt: Float -> Float -> Bool = \x: Float. \y: Float.
    (null (cmp (cmp x y) -1) true false)

gt: Float -> Float -> Bool = \x: Float. \y: Float.
    (null (cmp (cmp x y) 1) true false)

lte: Float -> Float -> Bool = \x: Float. \y: Float.
    (null (cmp x y) true (null (cmp (cmp x y) -1) true false))

gte: Float -> Float -> Bool = \x: Float. \y: Float.
    (null (cmp x y) true (null (cmp (cmp x y) 1) true false))

-- TODO: Make a general builtin for this
rotate2: Any -> Any -> Any -> Any = \fn: Any. \x: Any. \y: Any. (fn y x)

-- Math
abs: Float -> Float = \x: Float. (if (lt x 0) (mul -1 x) x)
